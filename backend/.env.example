# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database (Render PostgreSQL / local) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/santu_hardware
# Render managed Postgres requires SSL. Set to "true" in production.
DATABASE_SSL=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
REFRESH_TOKEN_EXPIRES_IN=30d

# --- CORS: comma separated list of allowed frontend origins ---
CORS_ORIGIN=http://localhost:5173

# --- Seed admin (used only by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@santuhardware.in
SEED_ADMIN_PASSWORD=Admin@12345

# Comma-separated 10-digit numbers. While set, WhatsApp sends ONLY to these (testing safety).
WHATSAPP_ALLOWED_NUMBERS=
EXCEL_MIRROR_DIR=
